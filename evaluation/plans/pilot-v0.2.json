      "prompt": "Which atomic memory ordering does the diff use to read the shared IO exit flag? Give the ordering name.",
      "required_answers": ["Acquire"]
    },
    {
      "id": "Q2",
      "case_id": "R5",
      "prompt": "What is the configured graceful-cancellation period, in milliseconds?",
      "required_answers": ["500"]
    },
    {
      "id": "Q3",
      "case_id": "R7",
      "prompt": "What exact Cargo test target could not be found?",
      "required_answers": ["minifycli_pilot_missing_target"]
    },
    {
      "id": "Q4",
      "case_id": "R8",
      "prompt": "Name the failing Rust test and its unique assertion-message marker.",
      "required_answers": ["z_controlled_failure", "MINIFYCLI_PILOT_RUST_ASSERTION"]
    },
    {
      "id": "Q5",
      "case_id": "J7",
      "prompt": "What exact npm script could not be found?",
      "required_answers": ["minifycli_pilot_missing_script"]
    },
    {
      "id": "Q6",
      "case_id": "J8",
      "prompt": "Name the deliberately failing JavaScript test and its unique assertion-message marker.",
